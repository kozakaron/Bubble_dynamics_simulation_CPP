cpp_compiler = 'clang++'
cuda_compiler = 'nvcc'
linker = 'clang++'
src_dirs = ['./src', './test']
include_dirs = ['./include', './test', './mechanism']
build_dir = './bin'
output_binary_name = 'main'
submodules = {
    "sundials": {
        "include_dir": "./submodules/sundials/install/include",
        "lib_dir": "./submodules/sundials/install/lib",
        "core_lib": "sundials_core"
    },
    "json": {
        "include_dir": "./submodules/json/include"
    },
    "cxxopt": {
        "include_dir": "./submodules/cxxopt/include"
    }
}
compiler_flags = ['-std=c++20', '-ftree-vectorize', '-pedantic', '-fno-fast-math', '-funroll-loops', '-O2']
linker_flags = ['-flto', '-Wl', '-O2']
common_flags = ['-Wall', '-Wextra', '-Werror']

